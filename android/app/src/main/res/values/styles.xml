<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light-only app (calm season palettes). Shown while the process starts;
         Android 12+ draws the launcher icon (season keyhole) on splash_bg. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
    </style>
    <!-- Window behind the Flutter UI once it is running. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>
</resources>
